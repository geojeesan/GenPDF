{
  "name": "genpdf",
  "version": "1.0.0",
  "desktopName": "genpdf.desktop",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.js",
    "start": "npm run build && electron electron/main.js",
    "pack:linux": "npm run build && electron-builder --linux deb rpm",
    "pack:deb": "npm run build && electron-builder --linux deb",
    "pack:rpm": "npm run build && electron-builder --linux rpm",
    "pack:appimage": "npm run build && electron-builder --linux AppImage"
  },
  "keywords": [
    "pdf",
    "viewer",
    "editor",
    "electron",
    "gtk4",
    "fluent"
  ],
  "author": "Geo Jeesan <81578090+geojeesan@users.noreply.github.com>",
  "license": "ISC",
  "description": "Cross-platform Fluent & GTK4 PDF Viewer and Editor",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  },
  "build": {
    "appId": "com.genpdf.studio",
    "productName": "GenPDF Studio",
    "executableName": "genpdf",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "Portable Document Format (PDF)",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "syncDesktopName": true,
      "maintainer": "Geo Jeesan <81578090+geojeesan@users.noreply.github.com>",
      "icon": "build/icon.png",
      "category": "Office;Graphics;Viewer",
      "desktop": {
        "entry": {
          "Name": "GenPDF Studio",
          "Comment": "Fast, modern PDF viewer and editor with GTK4 / Libadwaita styling",
          "GenericName": "PDF Editor",
          "Terminal": "false",
          "Type": "Application"
        }
      }
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "office"
    },
    "rpm": {
      "packageCategory": "Office"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
